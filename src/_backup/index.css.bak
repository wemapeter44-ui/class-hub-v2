@import "tailwindcss";

:root {
  /* Surfaces */
  --bg-app: #f5f3ff;
  --bg-app-2: #ede9fe;
  --bg-card: #ffffff;
  --bg-elevated: #faf9ff;

  /* Brand */
  --violet-50: #f5f3ff;
  --violet-100: #ede9fe;
  --violet-200: #ddd6fe;
  --violet-400: #a78bfa;
  --violet-500: #8b5cf6;
  --violet-600: #7c3aed;
  --violet-700: #6d28d9;

  /* Text */
  --text-primary: #1e1b4b;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;

  /* Borders */
  --border-subtle: #e9e5ff;
  --border-medium: #ddd6fe;
  --border-strong: #c4b5fd;
}

* { -webkit-tap-highlight-color: transparent; }

html, body, #root {
  min-height: 100%;
  background: var(--bg-app);
}

body {
  color: var(--text-primary);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Inputs */
input, textarea, select {
  color-scheme: light;
}

input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus {
  -webkit-text-fill-color: var(--text-primary);
  -webkit-box-shadow: 0 0 0 1000px #ffffff inset;
  transition: background-color 5000s ease-in-out 0s;
}

/* Scrollbar */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: var(--violet-200);
  border-radius: 999px;
}
::-webkit-scrollbar-thumb:hover { background: var(--violet-400); }

/* Card */
.surface {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 18px;
  box-shadow: 0 1px 2px rgba(124, 58, 237, 0.04), 0 4px 16px rgba(124, 58, 237, 0.04);
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}
.surface:hover {
  border-color: var(--border-medium);
  box-shadow: 0 2px 4px rgba(124, 58, 237, 0.06), 0 8px 24px rgba(124, 58, 237, 0.08);
}

/* Purple gradient header used on top of pages */
.brand-gradient {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 60%, #6d28d9 100%);
}

/* Primary button */
.btn-primary {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  color: white;
  border-radius: 14px;
  padding: 12px 20px;
  font-weight: 600;
  font-size: 14px;
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.25);
  transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
}
.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(124, 58, 237, 0.35);
}
.btn-primary:active { transform: translateY(0); }

/* Danger button (red) */
.btn-danger {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: white;
  border-radius: 14px;
  padding: 12px 20px;
  font-weight: 600;
  font-size: 14px;
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(239, 68, 68, 0.25);
}

/* Animations */
@keyframes fade-up {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-fade-up { animation: fade-up 0.35s ease-out both; }

@keyframes slide-in {
  from { opacity: 0; transform: translateX(20px); }
  to { opacity: 1; transform: translateX(0); }
}
.animate-slide-in { animation: slide-in 0.25s ease-out; }